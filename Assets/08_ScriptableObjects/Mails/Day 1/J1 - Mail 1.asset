  m_Script: {fileID: 11500000, guid: 38948bbc0f96de7498bb32b64efae4ec, type: 3}
  m_Name: J1 - Mail 1
  m_EditorClassIdentifier: 
  title: Congratulations!
  character: {fileID: 11400000, guid: 8db74389b8c31914dbe8c9c4cf3c818b, type: 2}
  hasDelay: 1
  hasRandomDelay: 0
  delay: 5
  maxDelay: 0
  mailText: "<size=12><b>Welcome to the family!</b>\n\nIt is our dearest pleasure
    to introduce you as our newest talent and ensure you have the resources required
    to kickstart your <b>CHERUB</b> journey!\n\nYou\u2019ve been assigned to the
    <b>8th floor</b>, and we hope you\u2019ll be just as eager to meet the wonderful
    people with whom you\u2019re going to share space during the next few months.\n\nYou
    will soon receive further instructions on your role at the company. Don\u2019t
    worry, you\u2019ll have all the time you need to adjust and familiarize yourself
    with your new, very special working environment.\n\nYour <b>new life</b> begins
    <b>with us</b>!"
