  m_Script: {fileID: 11500000, guid: 38948bbc0f96de7498bb32b64efae4ec, type: 3}
  m_Name: J1 - Mail 2
  m_EditorClassIdentifier: 
  title: Your role at CHERUB.
  character: {fileID: 11400000, guid: 8db74389b8c31914dbe8c9c4cf3c818b, type: 2}
  hasDelay: 1
  hasRandomDelay: 0
  delay: 15
  maxDelay: 0
  mailText: "<size=12>As a member of the <b>Nurturing Service</b>, your goal will
    be to assist your <b>siblings</b> (that\u2019s your coworkers!) in giving the
    best of themselves in their work endeavours.\n\nEach <b>CHERUB</b> employee is
    tasked with providing a <b>daily Self-Evaluation Report Form</b> (<b>S.E.R.F.</b>),
    ranking themselves across our <b>six core company values</b>, or <b>H.E.A.L.T.H</b>.\n\nYou
    will be entrusted to follow and validate these forms by sorting them according
    to guidelines that you will progressively receive during the next few days.\n\nBeyond
    your <b>13th-floor</b> colleagues, you will occasionally receive <b>backlog forms</b>
    from other floors to take care of as well. \n\nA first batch will soon be delivered
    today as a way to familiarise yourself with the sheets' format. \n\nTomorrow,
    your real work begins, and so does your bright new career!"
