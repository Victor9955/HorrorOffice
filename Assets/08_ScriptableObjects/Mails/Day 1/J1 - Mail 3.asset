  title: Daily S.E.R.F Validation Checklist
  character: {fileID: 11400000, guid: 8db74389b8c31914dbe8c9c4cf3c818b, type: 2}
  hasDelay: 0
  hasRandomDelay: 0
  delay: 0
  maxDelay: 0
  mailText: "<size=12>Greetings,\n\nHere is the list of information we require you
    to verify on today\u2019s report forms.\n\nReminder: employees not fulfilling
    any of these requirements should be given a <b>warning</b>.\n\n<b>SCHEDULE</b>\n\n-
    Arrival time is strictly between <b>8:30 AM</b> and <b>9 AM</b>.\n- Departure
    time is either at or after <b>4:30 PM</b>.\n- No more than <b>1 hour</b> of <b>total
    break time</b>.\n- No more than <b>30 minutes</b> of <b>consecutive break time</b>.\n\n<b>SELF-RATING</b>\n\n-
    At least <b>1 A\u2019s</b> in any given <b>H.E.A.L.T.H</b> categories.\n- No
    more than <b>3 E's</b> in any given <b>H.E.A.L.T.H</b> categories.\n\n<b>[THIS
    IS AN AUTOMATED MESSAGE. PLEASE DO NOT REPLY.]</b>"
