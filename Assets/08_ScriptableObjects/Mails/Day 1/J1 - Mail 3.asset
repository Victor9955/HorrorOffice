  m_Name: J1 - Mail 3
  m_EditorClassIdentifier: 
  title: Daily S.E.R.F Validation Checklist
  character: {fileID: 11400000, guid: 8db74389b8c31914dbe8c9c4cf3c818b, type: 2}
  mailText: "Greetings,\n\nHere is the list of information we require you to verify
    on today\u2019s report forms.\n\nReminder: employees not fulfilling any of these
    requirements should be given a <b>warning</b>.\n\n<b>SCHEDULE</b>\n\nArrival
    time is strictly between <b>8:30 AM</b> and <b>9 AM</b>.\n\nDeparture time is
    either at or after <b>4:30 PM</b>.\n\nNo more than <b>1 hour</b> of <b>total
    break time</b>.\n\nNo more than <b>30 minutes</b> of <b>consecutive break time</b>.\n\n<b>SELF-RATING</b>\n\nAt
    least <b>1 A\u2019s</b> in any given <b>H.E.A.L.T.H</b> categories.\n\nNo more
    than <b>3 E's</b> in any given <b>H.E.A.L.T.H</b> categories.\n\n<b>[THIS IS
    AN AUTOMATED MESSAGE. PLEASE DO NOT REPLY.]</b>"
