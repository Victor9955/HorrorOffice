  title: 'RE: Warning: Self-Report Data Mismatch'
  character: {fileID: 11400000, guid: 6e731307e1799234cada5ca4daea2a06, type: 2}
  mailText: "Greetings,\r\n\r\nIt is our pleasure to announce that the data discrepancy
