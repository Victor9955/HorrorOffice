  m_Name: TutoJ1 - Welcome aboard!
  m_EditorClassIdentifier: 
  title: Welcome aboard!
  character: {fileID: 11400000, guid: 8db74389b8c31914dbe8c9c4cf3c818b, type: 2}
  mailText: "Hello and welcome to our HR departement!\n\nYour job is to review the
    daily reports of our dear employees and file them appropriatly in the different
    drawer you will find on your desk.\n\n If a report seems incomplete, contains
    missinformations or does not compy with the fuidelines, please put them in the
    <b><color=red>r\xE9int\xE9gration</color></b> drawer. Either way please file
    the report as valid in the <b><color=green>Valid</b></color> drawer!\n\nPlease
    acknowledge that <b>superior</b> will send you mails with the informations you
    need to know and that they can change from a day to another.\n\n"
