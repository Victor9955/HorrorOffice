      dialogs:
        _serializedList:
        - Key: 3
          Value: "\xA4Nice one the other day. Very funny.  \xA4<sprite=Surprised>\u2026Don\u2019t
            do that again?  \xA4<sprite=Default>But hey. No offence taken.  \xA4\u2026"
        - Key: 2
          Value: "\xA4<sprite=Happy>Thanks for covering my ass yesterday.  \xA4Knew
            you were a real mate.  \xA4<sprite=Default>Really appreciate it. And
            you know I\u2019ll return the favour."
